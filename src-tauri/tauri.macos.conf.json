{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mangoprint Prepress PDF",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "backgroundColor": "#14151a",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "resources": {
      "ghostscript/bin/gs": "ghostscript/bin/gs",
      "ghostscript/COPYING.txt": "ghostscript/COPYING.txt",
      "ghostscript/README.txt": "ghostscript/README.txt",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    }
  }
}
